modid = "hexcasting"
book = "hexcasting:thehexbook"
default_lang = "en_us"
default_branch = "main"

# Resources are dumped by /genHexBook from the live server (mods/*.jar).
# The companion's own dir comes first so its lang overrides (site title,
# description, landing intro) win over the addon translations.
resource_dirs = [
    "src/hexdoc_livehexbook/resources",
    "resources",
    { modid="hexcasting" },
    { modid="minecraft" },
    { modid="hexdoc" },
]

[template]
# livehexbook first: its _templates/ override hexdoc's book landing box.
include = ["livehexbook", "hexcasting", "hexdoc"]

[template.args]
mod_name = "HexBook"
author = "xm1221"
show_landing_text = true

[extra.hexcasting]
allow_duplicates = true

# Patterns are exported from the live Action registry, not scraped from sources.
[[extra.hexcasting.pattern_stubs]]
type = "json"
path = "patterns-registry.json"

[textures]
missing = "*"
# Addon item models whose parents live in absent mods (e.g. Create) or are
# generated at runtime: log and fall back instead of failing the whole build.
strict = false
