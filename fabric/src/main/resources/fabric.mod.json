{
  "schemaVersion": 1,
  "id": "mielib",
  "version": "${version}",
  "name": "MieLib",
  "description": "An lib for hex-addons",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/MieLib",
    "sources": "https://github.com/xm1221/MieLib"
  },
  "license": "MIT",
  "icon": "assets/mielib/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieLib.fabric.FabricMielib"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieLib.fabric.FabricMielibClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieLib.fabric.FabricMielibServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieLib.fabric.datagen.FabricMielibDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.MieLib.fabric.FabricMielibModMenu"
    }]
  },
  "mixins": [
    "mielib-common.mixins.json",
    "mielib-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}"
  }
}
