  "mixins": ["hexcli.mixins.json"],
  "depends": {
    "minecraft": "1.20.1",
    "fabricloader": "*",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "hexcasting": "*",
    "hexparse": "*",
    "mielib": "*"
  }
